{{ 'section-crev-hero.css' | asset_url | stylesheet_tag }}

{%- assign collection_url = routes.all_products_collection_url -%}
<section class="crev-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="crev-hero__copy">
    <p class="crev-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="crev-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="crev-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--primary" href="{{ section.settings.button_link | default: collection_url }}">
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">&nbsp;↗</span>
      </a>
    {%- endif -%}
  </div>
  <div class="crev-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '400, 600, 800, 1000, 1400, 2000',
          sizes: '(min-width: 750px) 50vw, 100vw',
          fetchpriority: 'high',
          loading: 'eager',
          class: 'crev-hero__image'
      }}
    {%- else -%}
      <div class="crev-hero__placeholder" aria-hidden="true">
        {{ 'product-apparel-1' | placeholder_svg_tag: 'crev-hero__illustration' }}
        <span class="crev-hero__wordmark">CREV</span>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CREV — Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "CREV / ESSENTIALS" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Il tuo stile. Ogni giorno." },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Abbigliamento essenziale. Spazio alla tua personalità." },
    { "type": "text", "id": "button_label", "label": "Testo pulsante", "default": "Esplora la collezione" },
    { "type": "url", "id": "button_link", "label": "Link pulsante", "info": "Se vuoto, apre tutti i prodotti." },
    { "type": "image_picker", "id": "image", "label": "Immagine principale", "info": "Scegli una foto della collezione. In assenza di foto viene mostrata un’illustrazione segnaposto." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" }
  ],
  "presets": [{ "name": "CREV — Hero" }]
}
{% endschema %}
