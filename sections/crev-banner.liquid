{{ 'section-crev-banner.css' | asset_url | stylesheet_tag }}

<section
  class="crev-banner"
  style="--crev-banner-pattern: url('{% render 'crev-camouflage-url' %}');"
>
  <h1 class="crev-banner__heading">
    {{ section.settings.heading | escape | replace: 'CREV', '<span class="crev-banner__accent">CREV</span>' }}
  </h1>
</section>

{% schema %}
{
  "name": "CREV — Banner camouflage",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Devi CREVerci",
      "info": "Le lettere CREV vengono mostrate in arancione."
    }
  ],
  "presets": [{ "name": "CREV — Banner camouflage" }]
}
{% endschema %}
