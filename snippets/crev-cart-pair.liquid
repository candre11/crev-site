{%- doc -%}
  Suggests the other CREV shirt when exactly one of the two product types is in the cart.
  Sizes, separate line items and quantities do not affect the presence check.

  @param {string} context - A unique heading suffix: drawer or page.
{%- enddoc -%}
{%- liquid
  assign crev_has_cream = false
  assign crev_has_camo = false
  for item in cart.items
    assign crev_cart_handle = item.product.handle | default: item.handle
    if crev_cart_handle == 'cream-tribe-longsleeve'
      assign crev_has_cream = true
    elsif crev_cart_handle == 'tribe-longsleeve-camo'
      assign crev_has_camo = true
    endif
  endfor

  assign crev_pair_handle = ''
  if crev_has_cream and crev_has_camo == false
    assign crev_pair_handle = 'tribe-longsleeve-camo'
    assign crev_pair_title = 'Camo Tribe Longsleeve'
  elsif crev_has_camo and crev_has_cream == false
    assign crev_pair_handle = 'cream-tribe-longsleeve'
    assign crev_pair_title = 'Cream Tribe Longsleeve'
  endif
-%}
{%- if crev_pair_handle != blank -%}
  {%- liquid
    assign crev_pair_product = all_products[crev_pair_handle]
    assign crev_pair_path = 'products/' | append: crev_pair_handle
    assign crev_pair_url = routes.root_url | append: crev_pair_path
    if crev_pair_product.url != blank
      assign crev_pair_url = crev_pair_product.url
    endif
  -%}
  <crev-cart-pair class="crev-cart-pair" data-product-handle="{{ crev_pair_handle }}" hidden>
    <div class="crev-cart-pair__content" role="dialog" aria-modal="true" aria-labelledby="CrevCartPair-{{ context | escape }}" aria-describedby="CrevCartPairHint-{{ context | escape }}" tabindex="-1">
      <h2 id="CrevCartPair-{{ context | escape }}">Sappiamo che le vuoi entrambe</h2>
      <a class="crev-cart-pair__monkey" href="{{ crev_pair_url | escape }}" aria-label="Scopri {{ crev_pair_product.title | default: crev_pair_title | escape }}">
        <img src="{{ 'scimmia.png' | asset_url }}" width="160" height="160" alt="" loading="eager">
      </a>
      <p id="CrevCartPairHint-{{ context | escape }}" class="visually-hidden">Clicca sulla scimmia per scoprire l’altra maglia. Per chiudere, clicca in un altro punto o premi Esc.</p>
    </div>
  </crev-cart-pair>
{%- endif -%}
