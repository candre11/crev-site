{%- doc -%}
  Displays the original size PNGs. The native checked radio swaps empty artwork
  for the matching hand-drawn version. SVG viewports align transparent margins
  without modifying the uploaded files.

  @param {string} size - The Shopify size option value.
{%- enddoc -%}
{%- liquid
  assign size_key = size | upcase | strip | remove: ' '
  case size_key
    when 'SMALL'
      assign size_key = 'S'
    when 'MEDIUM'
      assign size_key = 'M'
    when 'LARGE'
      assign size_key = 'L'
    when 'EXTRALARGE'
      assign size_key = 'XL'
  endcase
-%}
{%- case size_key -%}
  {%- when 'S' -%}
    <svg class="crev-size-letter" data-size-art viewBox="0 0 170 196" width="170" height="196" aria-hidden="true" focusable="false">
      <image class="crev-size-letter__empty" href="{{ 'S vuota.png' | asset_url | escape }}" x="-38" y="-10.5" width="235" height="234" />
      <image class="crev-size-letter__selected" href="{{ 'S a mano.png' | asset_url | escape }}" x="-49" y="-24.5" width="253" height="239" />
    </svg>
  {%- when 'M' -%}
    <svg class="crev-size-letter" data-size-art viewBox="0 0 244 196" width="244" height="196" aria-hidden="true" focusable="false">
      <image class="crev-size-letter__empty" href="{{ 'M vuota.png' | asset_url | escape }}" x="-23" y="-21.5" width="295" height="234" />
      <image class="crev-size-letter__selected" href="{{ 'M a mano.png' | asset_url | escape }}" x="-26" y="-39.5" width="309" height="266" />
    </svg>
  {%- when 'L' -%}
    <svg class="crev-size-letter" data-size-art viewBox="0 0 120 196" width="120" height="196" aria-hidden="true" focusable="false">
      <image class="crev-size-letter__empty" href="{{ 'L vuota.png' | asset_url | escape }}" x="-38" y="3" width="171" height="167" />
      <image class="crev-size-letter__selected" href="{{ 'L a mano.png' | asset_url | escape }}" x="-40" y="2.5" width="190" height="195" />
    </svg>
  {%- when 'XL' -%}
    <svg class="crev-size-letter" data-size-art viewBox="0 0 352 196" width="352" height="196" aria-hidden="true" focusable="false">
      <image class="crev-size-letter__empty" href="{{ 'XL vuota.png' | asset_url | escape }}" x="-31" y="-11.5" width="389" height="190" />
      <image class="crev-size-letter__selected" href="{{ 'XL a mano.png' | asset_url | escape }}" x="-35" y="-15.5" width="401" height="215" />
    </svg>
  {%- else -%}
    {% render 'crev-size-letter-fallback', size: size %}
{%- endcase -%}
