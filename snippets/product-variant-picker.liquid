{%- doc -%}
  Renders a product variant picker as buttons, swatches, or dropdowns.

  @param {product} product - The product whose options and selected variant are rendered.
  @param {block} block - The variant-picker block and its picker settings.
  @param {string} product_form_id - The ID of the product form associated with the picker inputs.
  @param {object} [section] - The current product section context, supplied implicitly when rendered from that section and used to namespace picker controls.

  @example
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{%- enddoc -%}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type
        assign crev_size_option = false
        assign option_name = option.name | downcase
        if section.settings.crev_product_layout
          assign crev_size_values = true
          assign crev_known_sizes = '|XS|S|M|L|XL|XXL|XXXL|2XL|3XL|SMALL|MEDIUM|LARGE|EXTRALARGE|'
          for option_value in option.values
            assign crev_size_key = option_value | upcase | strip | remove: ' ' | prepend: '|' | append: '|'
            unless crev_known_sizes contains crev_size_key
              assign crev_size_values = false
            endunless
          endfor
          if option_name contains 'tagli' or option_name contains 'size' or option_name == 'misura' or option_name == 'dimensione' or crev_size_values
            assign crev_size_option = true
            assign picker_type = 'button'
          endif
        endif

        if swatch_count > 0 and block.settings.swatch_shape != 'none' and crev_size_option == false
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name | escape }}:
            <span data-selected-value>
              {{- option.selected_value | escape -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill{% if crev_size_option %} product-form__input--crev-size{% endif %}">
          <legend class="form__label">{{ option.name | escape }}</legend>
          {% render 'product-variant-options',
            option: option,
            block: block,
            picker_type: picker_type,
            crev_size_option: crev_size_option
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name | escape }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
