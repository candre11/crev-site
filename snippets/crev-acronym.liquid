<crev-acronym
  class="crev-acronym"
  role="group"
  aria-label="C.R.E.V."
>
  <a href="{{ routes.root_url }}" class="crev-acronym__home focus-inset" aria-label="C.R.E.V. — Home">
    <span class="visually-hidden">Home</span>
  </a>
  {% comment %}The viewBox omits transparent canvas margins while preserving the original PNG.{% endcomment %}
  <svg
    class="crev-acronym__artwork"
    viewBox="133 1109 2734 657"
    width="2734"
    height="657"
    aria-hidden="true"
    focusable="false"
  >
    <image href="{{ 'crev nero.png' | asset_url | escape }}" width="3000" height="3000" />
  </svg>
  {%- assign initials = 'C,R,E,V' | split: ',' -%}
  {%- assign endings = 'lothing,ejects,very,erges' | split: ',' -%}
  {%- assign letter_lefts = '0,27.542,50.549,75.201' | split: ',' -%}
  {%- assign letter_widths = '24.579,19.971,21.361,24.799' | split: ',' -%}
  {%- for initial in initials -%}
    {%- assign ending = endings[forloop.index0] -%}
    <button
      type="button"
      class="crev-acronym__letter"
      aria-label="{{ initial | append: ending }}"
      aria-expanded="false"
      style="--crev-letter-left: {{ letter_lefts[forloop.index0] }}%; --crev-letter-width: {{ letter_widths[forloop.index0] }}%;"
    >
      <span class="crev-acronym__ending" aria-hidden="true">{{ ending }}</span>
    </button>
  {%- endfor -%}
</crev-acronym>
